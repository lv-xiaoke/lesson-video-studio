# Node.js 24+。将此文件复制为 .env.local；Web 和 Worker 共用配置。
DATA_DIR=./data
# 同机一次仅启动一个 Worker。
RENDER_CONCURRENCY=2
# 可选：使用已安装的 Chrome / Chromium 的可执行文件绝对路径。
# REMOTION_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe

# MiniMax 配音。密钥仅保存在本机，配置后重启 Web 和 Worker。
MINIMAX_API_KEY=
MINIMAX_TTS_MODEL=speech-2.6-hd
# 可选：按你实际套餐填写“每一万字符的人民币价格”，不填写则只显示字符数。
MINIMAX_PRICE_PER_10K_CHARS=
# 可选：账户所用的官方接入地址；一般无需修改。
# MINIMAX_TTS_ENDPOINT=https://api.minimax.cn/v1/t2a_v2
