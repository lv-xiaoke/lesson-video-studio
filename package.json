{
  "name": "lesson-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.546",
    "@remotion/player": "4.0.546",
    "@remotion/renderer": "4.0.546",
    "@remotion/bundler": "4.0.546",
    "@remotion/cli": "4.0.546"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --env-file-if-exists=.env.local src/worker/index.ts",
    "studio": "remotion studio src/video/index.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
